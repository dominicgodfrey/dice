# Copy to .env.local for development. All EXPO_PUBLIC_* values are baked
# into the build and visible to users; never put a secret here.

# Backend. Unset: fixtures only. Development defaults to http://localhost:8080.
EXPO_PUBLIC_API_URL=

# Sentry (crash reports). Unset: off.
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (product analytics). Unset: off.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
